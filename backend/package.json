{
  "name": "car-collection-backend",
  "description": "CarCollection - A CarCollect workshop",
  "version": "1.0.0",
  "main": "server.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "dev": "nodemon --legacy-watch --exec \"node --env-file=./config/.env --inspect=0.0.0.0:16000 server.js\"",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "start": "node server.js"
  },
  "dependencies": {
    "@apollo/server": "4.12.2",
    "body-parser": "^2.2.0",
    "cors": "2.8.5",
    "express": "^4.21.2",
    "graphql-tag": "2.12.6",
    "graphql": "^16.11.0",
    "helmet": "8.1.0",
    "mongoose": "^8.18.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint": "^9.39.2",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14"
  },
  "imports": {
    "#*": "./src/*",
    "#constants/*": "./src/utils/constants/*",
    "#graphql/*": "./src/graphql/*",
    "#helpers/*": "./src/utils/helpers/*",
    "#modules/*": "./src/modules/*",
    "#security/*": "./src/utils/security/*",
    "#validation/*": "./src/utils/validation/*"
  }
}
