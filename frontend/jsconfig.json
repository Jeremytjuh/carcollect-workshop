{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/actions": ["./src/actions/index"],
      "@/components": ["./src/components/index"],
      "@/constants/*": ["./src/utils/constants/*"],
      "@/fields": ["./src/components/field/index"],
      "@/graphql": ["./src/graphql/index"],
      "@/helpers/*": ["./src/utils/helpers/*"],
      "@/hooks": ["./src/hooks/index"],
      "@/lang": ["./src/lang/index"],
      "@/layouts": ["./src/layouts/index"],
      "@/public/*": ["./public/*"],
    }
  },
  "exclude": [
    "./node_modules",
    "./.next"
  ],
  "include": [
    "./src/**/*"
  ]
}
